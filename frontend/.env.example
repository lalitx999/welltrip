# ------------------------------------------------------------------
# WellTrip Frontend environment (COPY to frontend/.env.local)
# Never commit real values.
# ------------------------------------------------------------------

# Backend API base URL (Django dev server)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Web client ID (Google Cloud Console)
# Register http://127.0.0.1:3000 as an Authorized JavaScript origin AND
# http://127.0.0.1:3000/callback/google as an Authorized redirect URI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
