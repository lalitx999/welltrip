# ------------------------------------------------------------------
# WellTrip Backend Environment (COPY this file to backend/.env)
# ------------------------------------------------------------------

# --- Django Core ---
DJANGO_SECRET_KEY=welltrip_production_secret_key_change_me_random_string_999
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.welltripthailand.com,welltripthailand.com,www.welltripthailand.com,localhost,127.0.0.1

# --- PostgreSQL 16 ---
DATABASE_URL=postgres://welltrip_user:welltrip_secure_password@postgres:5432/welltrip_prod

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0

# --- JWT Lifetimes (SimpleJWT) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Google OAuth 2.0 Client IDs ---
GOOGLE_OAUTH_CLIENT_IDS=930698548957-qut6f3ckhc0ht513eahful3ead6dpd92.apps.googleusercontent.com

# --- CORS (Vercel Frontend Origins) ---
CORS_ALLOWED_ORIGINS=https://welltripthailand.com,https://www.welltripthailand.com,https://welltrip.vercel.app

# --- Payee Account Details (Kasikornbank) ---
PAYEE_ACCOUNT_NUMBER=001-1-50448-5
PAYEE_ACCOUNT_NAME=นาย พรหมลิขิต อุรา
PAYEE_BANK_NAME=ธนาคารกสิกรไทย

# --- EasySlip Payment Slip Verification ---
SLIP_PROVIDER_URL=https://developer.easyslip.com/api/v1/verify
SLIP_PROVIDER_API_KEY=
EASYSLIP_MOCK_VERIFY=True

# --- Dual-AI Architecture Keys ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
