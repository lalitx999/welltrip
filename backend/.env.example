# ------------------------------------------------------------------
# WellTrip Backend environment variables (COPY this file to backend/.env)
# Never commit the real .env file (already git-ignored).
# ------------------------------------------------------------------

# --- Django core ---
# REQUIRED: generate a real one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL 15+ ---
# user:password@host:port/dbname  -> create the db first:  createdb welltrip
DATABASE_URL=postgres://welltrip:welltrip@127.0.0.1:5432/welltrip

# --- JWT lifetimes (SimpleJWT) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Google OAuth ---
# One or more OAuth 2.0 "Web client" IDs from Google Cloud Console,
# comma-separated if you have multiple environments.
GOOGLE_OAUTH_CLIENT_IDS=your-client-id.apps.googleusercontent.com

# --- CORS (Next.js origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
